# Single stage build with Go
FROM  online-registry.cn-hongkong.cr.aliyuncs.com/okbase/golang:1.24.4-just-foundry as builder
WORKDIR /root
COPY . .

# Build Go binaries with user-provided metadata
RUN cd op-batcher && just
FROM online-registry.cn-hongkong.cr.aliyuncs.com/okbase/alpine:3.18.3-okg1

COPY --from=builder  /root/op-batcher/bin/op-batcher /usr/local/bin/op-batcher
WORKDIR /root
CMD ["op-batcher"]
